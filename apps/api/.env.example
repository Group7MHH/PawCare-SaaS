# PostgreSQL central: DB local mặc định của docker compose up -d db
DATABASE_URL=postgresql://pawcare:pawcare_local_only@localhost:5432/pawcare
PG_POOL_MAX=10
PORT=4000
APP_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
# Chỉ tạo OWNER đầu tiên bằng lệnh npm run db:bootstrap-owner.
# Không hardcode tài khoản hay mật khẩu thực vào Git.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_FULL_NAME=Chủ nền tảng PawCare
# Optional, lần triển khai đầu: phải tắt và xóa mật khẩu ngay sau bootstrap.
BOOTSTRAP_OWNER=false
